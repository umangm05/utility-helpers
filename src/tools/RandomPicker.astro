---
// Spin the wheel + random picker + dice & coin (UH-T3 tool 9).
// Outcomes come from crypto.getRandomValues (unbiased), computed in this tab only.
import "../styles/tools.css";
---
<div class="tool ft" id="rp">
  <div class="ft-tabs" role="tablist" aria-label="Random tool">
    <button type="button" role="tab" id="rp-tab-wheel" aria-controls="rp-wheel" data-hash="wheel" aria-selected="true">Spin the wheel</button>
    <button type="button" role="tab" id="rp-tab-pick" aria-controls="rp-pick" data-hash="picker" aria-selected="false" tabindex="-1">Random picker</button>
    <button type="button" role="tab" id="rp-tab-dice" aria-controls="rp-dice" data-hash="dice" aria-selected="false" tabindex="-1">Dice &amp; coin</button>
  </div>

  <section class="ft-panel" id="rp-wheel" role="tabpanel" aria-labelledby="rp-tab-wheel">
    <div class="sw">
      <div class="sw-stage">
        <span class="sw-pointer" aria-hidden="true"></span>
        <canvas id="sw-canvas" width="340" height="340" role="img" aria-label="Wheel"></canvas>
        <button type="button" class="sw-hub" id="sw-spin">Spin</button>
      </div>
      <div class="ft sw-side">
        <div>
          <label for="sw-list">Names or options, one per line</label>
          <textarea id="sw-list" rows="8" spellcheck="false">Pizza
Biryani
Dosa
Burger
Momos
Pasta</textarea>
        </div>
        <p class="ft-status sw-result" id="sw-result" role="status" aria-live="polite">Press Spin (or the wheel’s centre).</p>
        <div class="ft-row">
          <button type="button" class="btn-ghost" id="sw-remove" hidden>Remove winner</button>
          <button type="button" class="btn-ghost" id="sw-shuffle">Shuffle</button>
          <button type="button" class="btn-ghost sfx-toggle" aria-pressed="true">Sound: on</button>
        </div>
      </div>
    </div>
  </section>

  <section class="ft-panel ft" id="rp-pick" role="tabpanel" aria-labelledby="rp-tab-pick" hidden>
    <div class="ft-opts">
      <div>
        <label for="pk-mode">Pick</label>
        <select id="pk-mode">
          <option value="names" selected>Names from a list</option>
          <option value="number">A number in a range</option>
          <option value="teams">Split the list into teams</option>
        </select>
      </div>
      <div data-pk="names teams"><label for="pk-n">How many?</label><input id="pk-n" type="number" min="1" max="500" value="1" inputmode="numeric"></div>
      <div data-pk="number" hidden><label for="pk-min">From</label><input id="pk-min" type="number" value="1" inputmode="numeric"></div>
      <div data-pk="number" hidden><label for="pk-max">To</label><input id="pk-max" type="number" value="100" inputmode="numeric"></div>
    </div>
    <div data-pk="names teams">
      <label for="pk-list">List, one per line</label>
      <textarea id="pk-list" rows="6" spellcheck="false">Asha
Rahul
Meera
Vikram
Zoya
Kabir</textarea>
    </div>
    <div class="ft-row"><button type="button" id="pk-go">Pick</button></div>
    <div class="pk-out" id="pk-out" role="status" aria-live="polite"></div>
  </section>

  <section class="ft-panel ft" id="rp-dice" role="tabpanel" aria-labelledby="rp-tab-dice" hidden>
    <div class="ft-opts">
      <div><label for="dc-n">Number of dice</label><select id="dc-n"><option>1</option><option selected>2</option><option>3</option><option>4</option><option>5</option><option>6</option></select></div>
      <div><label for="dc-s">Sides</label><select id="dc-s"><option value="4">d4</option><option value="6" selected>d6</option><option value="8">d8</option><option value="10">d10</option><option value="12">d12</option><option value="20">d20</option></select></div>
    </div>
    <div class="ft-row">
      <button type="button" id="dc-roll">Roll dice</button>
      <button type="button" class="btn-ghost" id="dc-coin">Flip a coin</button>
    </div>
    <div class="dc-faces" id="dc-faces" aria-hidden="true"></div>
    <p class="ft-status dc-total" id="dc-out" role="status" aria-live="polite">Roll the dice or flip a coin.</p>
    <p class="ft-note" id="dc-hist"></p>
  </section>
</div>
<style>
  .sw { display: flex; flex-wrap: wrap; gap: 1.5rem; align-items: center; }
  .sw-stage { position: relative; width: min(340px, 100%); aspect-ratio: 1; flex: none; margin: 0 auto; }
  #sw-canvas { width: 100%; height: 100%; display: block; }
  .sw-pointer {
    position: absolute; left: 50%; top: -6px; transform: translateX(-50%); z-index: 1;
    border-left: 14px solid transparent; border-right: 14px solid transparent; border-top: 26px solid var(--fg);
    filter: drop-shadow(0 2px 2px rgba(0,0,0,.3));
  }
  .sw-hub {
    position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); width: 76px; height: 76px;
    border-radius: 50%; font-weight: 800; box-shadow: 0 4px 14px rgba(0,0,0,.25); border: 4px solid var(--panel);
  }
  .sw-side { flex: 1 1 16rem; }
  .sw-side textarea { width: 100%; }
  .sw-result { font-size: 1.125rem; }
  .sw-result strong { font-size: 1.5rem; color: var(--accent-ink); }
  [data-pk][hidden] { display: none; }
  .pk-out { display: flex; flex-wrap: wrap; gap: .5rem; min-height: 2.5rem; }
  .pk-out .chip { padding: .4rem .8rem; border-radius: 99px; background: var(--accent-soft); border: 1px solid var(--accent); font-weight: 650; }
  .pk-out .team { flex: 1 1 12rem; padding: .6rem .8rem; border-radius: var(--radius-sm); border: 1px solid var(--border); background: var(--panel-2); }
  .pk-out .team b { display: block; color: var(--accent-ink); }
  .pk-out .big { font-size: 2.5rem; font-weight: 800; color: var(--accent-ink); }
  .dc-faces { display: flex; flex-wrap: wrap; gap: .75rem; min-height: 4.5rem; }
  .dc-faces span {
    width: 4.25rem; height: 4.25rem; display: grid; place-items: center; border-radius: 14px; font: 800 1.75rem/1 var(--font);
    background: var(--panel-2); border: 2px solid var(--border); box-shadow: var(--shadow);
  }
  .dc-faces .rolling { animation: dc-shake .45s var(--ease); }
  @keyframes dc-shake { 0% { transform: rotate(-25deg) scale(.8); } 60% { transform: rotate(12deg) scale(1.08); } 100% { transform: none; } }
  .dc-total { font-size: 1.125rem; }
  @media (prefers-reduced-motion: reduce) { .dc-faces .rolling { animation: none; } }
</style>
<script>import "./random-picker.ts";</script>
