# Cloudflare Pages response headers (ported from netlify.toml [[headers]]).
# Astro copies public/ into dist/, so this ships as dist/_headers.
# Unknown paths need no rule: Pages serves dist/404.html with a 404 status.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(self)

# Astro's hashed bundles never change content under the same name.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Unhashed static assets (site.js, og.png, favicon.svg).
/assets/*
  Cache-Control: public, max-age=604800

# Service worker: always revalidate so a new build's worker is picked up promptly.
/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /

/manifest.webmanifest
  Content-Type: application/manifest+json; charset=utf-8
  Cache-Control: public, max-age=86400

# Background-remover model: the file name is versioned by content.
/models/*
  Cache-Control: public, max-age=31536000, immutable

/sfx/*
  Cache-Control: public, max-age=604800
