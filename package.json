{
  "name": "utility-helpers",
  "private": true,
  "type": "module",
  "description": "Utility Helpers: Astro static site (dist/) generated from site.config.json, plus Netlify Functions for consent-gated usage counts and the suggestion form.",
  "scripts": {
    "gen": "node scripts/gen-tool-slugs.mjs",
    "build": "node scripts/gen-tool-slugs.mjs && astro build",
    "dev": "astro dev",
    "preview": "astro preview",
    "test": "node --test netlify/tests/*.test.mjs",
    "check": "python3 scripts/check_dist.py"
  },
  "dependencies": {
    "@netlify/blobs": "^10.0.0",
    "astro": "^7.4.13"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
